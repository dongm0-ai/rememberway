# 실제 키는 .env.local(로컬)과 Vercel 환경변수에만. 이 파일은 예시이며 커밋해도 됨. .env.local 은 절대 커밋 금지.

# 생성형 AI: 키가 있는 제공자를 upstage → gemini → claude 순으로 쓴다. 앞 것이 크레딧 소진·장애면 자동으로 다음으로.
# AI_PROVIDER=upstage        # 하나만 쓰고 싶을 때(실험 비교용)만 지정
# AI_PROVIDER_CHAIN=upstage,gemini,claude

# Upstage Solar (OpenAI 호환). console.upstage.ai → API Keys. 모델: solar-pro4(기본) / solar-mini4(빠름)
UPSTAGE_API_KEY=up_...
UPSTAGE_MODEL=solar-pro4

# Gemini (교육용 키)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3-flash-preview

# Claude를 쓸 때만
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-5

# 지도는 OpenStreetMap(키 불필요). 카카오로 바꾸려면 결정표 참고.

# 키 남용 방지: AI 호출을 받을 화면 주소(쉼표 구분). Vercel 기본 주소는 이미 포함.
# ALLOWED_HOSTS=rememberway.vercel.app,localhost:3000
# RATE_PER_MIN=20
# RATE_PER_DAY=2000

# 1 이면 AI를 부르지 않고 모의 응답 (화면 흐름 점검용). 화면에 "모의 응답"이라고 표시된다. 시연 때는 반드시 0 또는 지움.
MOCK_AI=0
