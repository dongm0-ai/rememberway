# ================================================================
# REMEMBER WAY AI — 설정 파일 (전체 목록)
# ----------------------------------------------------------------
# 이 파일(.env.example)은 설명서이며 저장소에 올라갑니다. 값은 비워 둡니다.
#   PC에서 실행할 때 : 이 파일을 .env.local 로 복사해 값을 채웁니다 (.env.local 은 커밋되지 않음).
#   실제 서비스(Vercel): Vercel → Settings → Environment Variables 에 같은 이름으로 넣고 Redeploy.
# 비밀값(API_KEY, SECRET)은 절대 코드나 이 파일에 적지 않습니다.
# ================================================================

# ---------- 1. 생성형 AI ----------
# 키가 있는 제공자를 upstage → gemini → claude 순으로 씁니다. 앞 것이 크레딧 소진·장애면 자동으로 다음으로.
# AI_PROVIDER=upstage                # 하나만 쓰고 싶을 때(실험 비교용)만 지정
# AI_PROVIDER_CHAIN=upstage,gemini,claude

UPSTAGE_API_KEY=                    # console.upstage.ai → API Keys (up_...)
UPSTAGE_MODEL=solar-pro4            # 대체: solar-mini4
# UPSTAGE_FALLBACKS=solar-pro4,solar-mini4

GEMINI_API_KEY=                     # aistudio.google.com/apikey (AIza...)
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACKS=gemini-3.8-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# ANTHROPIC_API_KEY=                # Claude를 쓸 때만 (sk-ant-...)
# CLAUDE_MODEL=claude-sonnet-4-5

# ---------- 2. 지도 ----------
# MAP_PROVIDER=osm   : OpenStreetMap (키 없음, 기본)
# MAP_PROVIDER=naver : 네이버 지도 (네이버클라우드 Maps → Dynamic Map·Geocoding 신청, Web 서비스 URL에 아래 APP_URL 등록)
MAP_PROVIDER=osm
NAVER_CLIENT_ID=                    # 공개용 (브라우저에 내려감). 네이버클라우드 콘솔 → Maps → Application → Client ID
NAVER_CLIENT_SECRET=                # 비밀 (서버에서 Geocoding 호출에만 사용)

# 가게·시설 이름 검색("석교동 경로당", "집 근처 편의점"): 네이버클라우드 NAVER API HUB → Application 등록 → 검색(지역) → 인증 정보
NAVER_APIHUB_CLIENT_ID=             # 서버 전용
NAVER_APIHUB_CLIENT_SECRET=         # 서버 전용
# (구 개발자센터 검색 API 키가 이미 있는 경우에만) NAVER_SEARCH_CLIENT_ID= / NAVER_SEARCH_CLIENT_SECRET=
# 위가 없으면 OSM 공개 서버(Nominatim·Overpass)로 대신 찾습니다(동네 가게 정확도 낮음). 도보 길찾기는 항상 OSRM(키 없음).
# 네이버 Directions 5 는 자동차 전용이라 도보 동선에는 쓰지 않습니다.

# ---------- 3. 주소·보안 ----------
APP_URL=https://rememberway.vercel.app          # 서비스 주소 (네이버·카카오 콘솔의 Web 도메인에도 이 값을 등록)
ALLOWED_HOSTS=rememberway.vercel.app,localhost:3000   # 이 주소에서 온 요청만 AI를 부릅니다 (키 남용 방지)
RATE_PER_MIN=20                     # IP당 1분 호출 상한
RATE_PER_DAY=2000                   # 인스턴스당 하루 호출 상한

# ---------- 4. 일지 알림 (웹 푸시) ----------
# 저장소: Supabase. Vercel → Storage(Marketplace) → Supabase 연결하면 아래 값이 자동으로 생김. 그다음 docs/supabase.sql 을 SQL Editor에서 한 번 실행
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=        # 비밀 (서버 전용, 절대 브라우저에 두지 않음)
# CRON_SECRET=                      # 선택. 넣으면 Vercel Cron만 알림 발송 함수를 부를 수 있음
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY=   # 선택. 비워 두면 저장소에 자동으로 만들어 둠
# 발송 시각: vercel.json "crons" (/api/push?cron=1) — 매일 18시·21시(한국 시간). 무료 플랜은 그 시각 1시간 안 어느 때나 실행될 수 있음

# ---------- 5. 개발·시연 ----------
MOCK_AI=0                           # 1이면 AI를 부르지 않고 모의 응답(화면에 "모의 응답" 표시). 시연 때는 반드시 0
# PORT=3000                         # 로컬 서버 포트
