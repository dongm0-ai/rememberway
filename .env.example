# 실제 키는 .env.local(로컬)과 Vercel 환경변수에만. 이 파일은 예시이며 커밋해도 됨. .env.local 은 절대 커밋 금지.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5
# 카카오 개발자 > 내 애플리케이션 > 앱 키 > JavaScript 키. 플랫폼(Web)에 localhost:3000 과 Vercel 도메인 등록 필요.
KAKAO_JS_KEY=...
# 1 이면 Claude를 부르지 않고 모의 응답 (화면 흐름 점검용). 화면에 "모의 응답"이라고 표시된다. 시연 때는 반드시 0 또는 지움.
MOCK_AI=0
